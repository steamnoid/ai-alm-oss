JIRA_SITE=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_TOKEN=your-api-token
GITHUB_TOKEN=ghp_your-token   # scope: public_repo (forks + PRs)

# Dedicated bot site (board-provision / governed pipeline). JIRA_BOT_PASSWORD is
# the Atlassian login password used by the Playwright board-column phase — it is
# NOT stored in .env (kept in CI secrets). JIRA_BOT_TOKEN is the API token for REST.
JIRA_BOT_SITE=https://your-bot-site.atlassian.net
JIRA_BOT_EMAIL=bot@example.com
JIRA_BOT_TOKEN=your-bot-api-token
JIRA_BOT_PASSWORD=your-atlassian-login-password

