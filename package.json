{
  "name": "ai-alm-oss",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Governed autonomous issue-to-PR workflow for public OSS repositories",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
"onboard": "tsx scripts/onboard.mts",
  "discover": "tsx scripts/discover.mts",
  "notes": "tsx scripts/notes-onboard-discover.mts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
