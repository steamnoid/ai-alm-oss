{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "~/Develop/*": "allow",
      "/tmp/*": "allow",
      "/var/folders/*": "allow"
    }
  },
  "mcp": {
    "jira": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian"],
      "environment": {
        "JIRA_URL": "https://paligakrzychu.atlassian.net",
        "JIRA_USERNAME": "{env:JIRA_BOT_EMAIL}",
        "JIRA_API_TOKEN": "{env:JIRA_BOT_TOKEN}"
      },
      "enabled": true
    },
    "jira-oss": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian"],
      "environment": {
        "JIRA_URL": "https://ai-alm-oss.atlassian.net",
        "JIRA_USERNAME": "{env:JIRA_EMAIL}",
        "JIRA_API_TOKEN": "{env:JIRA_TOKEN}"
      },
      "enabled": true
    }
  }
}
